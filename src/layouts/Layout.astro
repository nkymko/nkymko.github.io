---
interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = "Nickymicko Ayub — Software Engineer & UI/UX Designer. I build software that replaces manual work.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="author" content="Nickymicko Ayub" />
		<meta name="theme-color" content="#000000" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content="https://nkymko.github.io" />
		<meta property="og:image" content="/My Pic.jpg" />
		<meta name="twitter:card" content="summary_large_image" />

		<title>{title}</title>
	</head>
	<body
		class="bg-black text-slate-200 antialiased selection:bg-sky-500/30 selection:text-white overflow-x-hidden"
	>
		<slot />
	</body>
</html>

<style is:global>
	/* Helvetica-first minimalist stack */
	html {
		font-family: "Helvetica Neue", Helvetica, Arial, "Inter", system-ui, sans-serif;
		scroll-behavior: smooth;
		background-color: #000;
	}

	body {
		min-height: 100vh;
	}

	/* Soft ambient glow, subtle and static */
	#bg-glow {
		position: fixed;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		background:
			radial-gradient(60% 50% at 75% 0%, rgba(2, 132, 199, 0.16) 0%, rgba(0, 0, 0, 0) 60%),
			radial-gradient(50% 50% at 15% 100%, rgba(2, 132, 199, 0.08) 0%, rgba(0, 0, 0, 0) 60%);
	}

	/* Reveal on scroll */
	.reveal {
		opacity: 0;
		transform: translateY(24px);
		transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
			transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
		will-change: opacity, transform;
	}

	.reveal.is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	@media (prefers-reduced-motion: reduce) {
		.reveal {
			opacity: 1;
			transform: none;
			transition: none;
		}
		html {
			scroll-behavior: auto;
		}
	}

	img {
		transition: filter 0.9s ease, transform 0.5s ease;
	}

	.grayscale {
		-webkit-filter: grayscale(100%);
		filter: grayscale(100%);
	}

	/* Gradient text accent */
	.text-gradient {
		background: linear-gradient(90deg, #38bdf8, #0284c7 60%, #e2e8f0);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.section-label {
		display: inline-flex;
		align-items: baseline;
		gap: 0.4rem;
		font-size: 0.95rem;
		font-weight: 400;
		letter-spacing: 0;
		text-transform: none;
		color: #7dd3fc;
	}

	.section-label::before {
		content: "//";
		color: #0ea5e9;
		font-weight: 500;
	}

	::-webkit-scrollbar {
		width: 10px;
	}
	::-webkit-scrollbar-track {
		background: #000;
	}
	::-webkit-scrollbar-thumb {
		background: #1f2937;
		border-radius: 9999px;
		border: 2px solid #000;
	}
	::-webkit-scrollbar-thumb:hover {
		background: #0284c7;
	}
</style>
