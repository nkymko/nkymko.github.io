---
const links = [
	{ label: "About", href: "#about" },
	{ label: "Work", href: "#experience" },
	{ label: "Skills", href: "#skills" },
	{ label: "Awards", href: "#awards" },
];
---

<nav
	id="navbar"
	class="fixed top-0 inset-x-0 z-50 transition-transform transition-colors duration-300 ease-out border-b border-transparent"
>
	<div class="max-w-3xl mx-auto flex items-center justify-between py-5 px-6">
		<a href="#top" class="group">
			<span class="text-lg font-semibold tracking-tight">
				nkymko<span class="text-sky-500 group-hover:text-sky-400 transition-colors">.</span>
			</span>
		</a>

		<div class="flex items-center gap-8">
			<ul class="hidden md:inline-flex gap-8 text-sm">
				{
					links.map((link) => (
						<li>
							<a
								href={link.href}
								class="relative text-slate-400 hover:text-slate-100 transition-colors after:absolute after:-bottom-1 after:left-0 after:h-px after:w-0 after:bg-sky-500 after:transition-all after:duration-300 hover:after:w-full"
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
			<a
				href="#contact"
				class="text-sm px-4 py-2 border border-slate-700 rounded-full text-slate-200 hover:border-sky-500 hover:text-sky-400 transition-all duration-300"
			>
				Say hi
			</a>
		</div>
	</div>
</nav>

<script>
	const navbar = document.getElementById("navbar");
	let lastY = window.scrollY;
	let ticking = false;
	// Minimum movement before we react, so tiny jitters don't flip the bar.
	const DELTA = 6;

	const show = () => navbar?.classList.remove("-translate-y-full");
	const hide = () => navbar?.classList.add("-translate-y-full");

	const update = () => {
		if (!navbar) return;
		const y = window.scrollY;

		// Frosted background once we leave the very top.
		if (y > 40) {
			navbar.classList.add("bg-black/70", "backdrop-blur-md", "border-slate-800/80");
		} else {
			navbar.classList.remove("bg-black/70", "backdrop-blur-md", "border-slate-800/80");
		}

		if (Math.abs(y - lastY) > DELTA) {
			// Follows the last scroll direction only — no auto-show when idle.
			// Scrolling down past the hero height -> hide. Scrolling up -> show.
			if (y > lastY && y > 120) {
				hide();
			} else {
				show();
			}
			lastY = y;
		}

		ticking = false;
	};

	window.addEventListener(
		"scroll",
		() => {
			if (!ticking) {
				window.requestAnimationFrame(update);
				ticking = true;
			}
		},
		{ passive: true }
	);
	update();
</script>
